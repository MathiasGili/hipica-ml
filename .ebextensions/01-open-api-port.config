# Open TCP 8080 on the EBS-managed security group so /docs (FastAPI Swagger UI)
# is reachable from the public internet.
# Streamlit stays on port 80 (default).
Resources:
  ApiIngress8080:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 8080
      ToPort: 8080
      CidrIp: 0.0.0.0/0
